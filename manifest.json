{
  "schemaVersion": 1,
  "id": "sarr.windowpeek",
  "name": "WindowPeek",
  "version": "0.7.2",
  "author": "Sarr",
  "license": "MIT",
  "description": "Never lose a window again. Find, preview and switch to windows across workspaces, monitors and Hyprland group tabs from Omarchy’s bar. Hover to browse, click to search, or move windows between workspaces and the scratchpad. Hold Shift to hide previews. Includes keyboard shortcuts, 30 languages, native themes, scaling, custom labels, saved color presets and instant popups. Keep Omarchy's look and workflow, without adding a macOS-style dock, Launchpad, Mission Control, or a Windows-like desktop.",
  "kinds": ["bar-widget"],
  "entryPoints": {"barWidget": "Widget.qml"},
  "barWidget": {
    "displayName": "WindowPeek",
    "description": "Search windows and Hyprland group tabs",
    "category": "Compositor",
    "defaultSection": "left",
    "allowMultiple": false,
    "defaults": {
      "language": "auto",
      "includeSpecial": true,
      "windowPreviews": true,
      "previewBackdrop": true,
      "previewFit": true,
      "openOnHover": true,
      "doubleClickExpand": false,
      "pinByTitleClick": true,
      "hoverLogo": true,
      "settingsLogo": true,
      "hoverLogoImage": "",
      "settingsLogoImage": "",
      "hoverLogoLoop": true,
      "settingsLogoLoop": true,
      "hoverLogoLoopDelay": 4.2,
      "settingsLogoLoopDelay": 4.2,
      "hoverLogoCooldown": 0,
      "settingsLogoCooldown": 0,
      "hoverLogoCooldownUnit": "s",
      "settingsLogoCooldownUnit": "s",
      "sharedLogoCooldownEnabled": false,
      "sharedLogoCooldown": 0,
      "sharedLogoCooldownUnit": "s",
      "panelHoverDelay": 400,
      "previewHoverDelay": 400,
      "popupAnimations": true,
      "scrollBounce": true,
      "wheelScrollSpeed": 102,
      "shortcutNumbersRight": false,
      "shortcuts": {},
      "panelStyle": "wallpaper",
      "followBarStyle": false,
      "glassTransparency": 8,
      "wallpaperTransparency": 70,
      "wallpaperThemeTransparencies": {},
      "backgroundBlur": false,
      "backgroundTexture": true,
      "barLabel": "full",
      "hintsMode": "auto",
      "hintsUsed": 0,
      "autoUpdates": true,
      "colorMode": "adaptive",
      "colorScope": "theme",
      "themeColors": {},
      "colorPresets": [],
      "surfaceColors": {},
      "uiScale": 1,
      "barScale": 1
    },
    "schema": [
      {"key": "includeSpecial", "type": "boolean", "label": "Include special workspaces"},
      {"key": "previewBackdrop", "type": "boolean", "label": "Dark backing behind preview image"},
      {"key": "previewFit", "type": "boolean", "label": "Fit preview frame to window proportions"},
      {"key": "windowPreviews", "type": "boolean", "label": "Window previews"},
      {"key": "openOnHover", "type": "boolean", "label": "Open panel on hover"},
      {"key": "doubleClickExpand", "type": "boolean", "label": "Expand on double-click"},
      {"key": "pinByTitleClick", "type": "boolean", "label": "Allow pinning compact panel"},
      {"key": "hoverLogo", "type": "boolean", "label": "Logo in hover panel"},
      {"key": "settingsLogo", "type": "boolean", "label": "Logo in Settings"},
      {"key": "hoverLogoImage", "type": "string", "label": "Compact logo: Omarchy, builtin:omarchy-pixel or local file URL"},
      {"key": "settingsLogoImage", "type": "string", "label": "Settings logo: Omarchy, builtin:omarchy-pixel or local file URL"},
      {"key": "hoverLogoLoop", "type": "boolean", "label": "Loop compact logo animation"},
      {"key": "settingsLogoLoop", "type": "boolean", "label": "Loop Settings logo animation"},
      {"key": "hoverLogoLoopDelay", "type": "number", "label": "Compact logo loop delay (seconds)"},
      {"key": "settingsLogoLoopDelay", "type": "number", "label": "Settings logo loop delay (seconds)"},
      {"key": "hoverLogoCooldown", "type": "number", "label": "Compact logo animation cooldown (seconds)"},
      {"key": "settingsLogoCooldown", "type": "number", "label": "Settings logo animation cooldown (seconds)"},
      {"key": "hoverLogoCooldownUnit", "type": "string", "label": "Compact logo cooldown unit: s or min"},
      {"key": "settingsLogoCooldownUnit", "type": "string", "label": "Settings logo cooldown unit: s or min"},
      {"key": "sharedLogoCooldownEnabled", "type": "boolean", "label": "Share animation cooldown between logos"},
      {"key": "sharedLogoCooldown", "type": "number", "label": "Shared logo animation cooldown (seconds)"},
      {"key": "sharedLogoCooldownUnit", "type": "string", "label": "Shared logo cooldown unit: s or min"},
      {"key": "panelHoverDelay", "type": "number", "label": "Bar hover delay (0–2000 ms; 0 = instant)"},
      {"key": "previewHoverDelay", "type": "number", "label": "Window preview delay (0–2000 ms; 0 = instant)"},
      {"key": "popupAnimations", "type": "boolean", "label": "Popup animations"},
      {"key": "scrollBounce", "type": "boolean", "label": "Springy scrolling"},
      {"key": "wheelScrollSpeed", "type": "number", "label": "Mouse wheel speed (50–300%; default 102%)"},
      {"key": "shortcutNumbersRight", "type": "boolean", "label": "Shortcut numbers on the right"},
      {"key": "panelStyle", "type": "string", "label": "Panel background: solid, wallpaper or glass"},
      {"key": "followBarStyle", "type": "boolean", "label": "Follow bar style in Wallpaper mode"},
      {"key": "glassTransparency", "type": "number", "label": "Window transparency (0–100%)"},
      {"key": "backgroundBlur", "type": "boolean", "label": "Blur wallpaper"},
      {"key": "backgroundTexture", "type": "boolean", "label": "Subtle grain"},
      {"key": "barLabel", "type": "string", "label": "Bar label: full, compact or name"},
      {"key": "language", "type": "string", "label": "Language code, or auto"},
      {"key": "uiScale", "type": "number", "label": "Panel scale (0.8–2.0)"},
      {"key": "barScale", "type": "number", "label": "Bar text scale (0.8–2.0)"}
    ]
  }
}
